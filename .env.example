# ========================================================
# CONFIGURACIÓN DE BASE DE DATOS Y COLAS
# ========================================================
# Conexión a MongoDB (Local o MongoDB Atlas)
MONGODB_URI=mongodb://sa:123456@localhost:27017/extraction_db

# Conexión a Redis (Broker y Result Backend para Celery)
REDIS_URL=redis://localhost:6379/0

# ========================================================
# PROVEEDOR DE INTELIGENCIA ARTIFICIAL
# ========================================================
# Opciones disponibles: "gemini" o "openai"
AI_PROVIDER=gemini

# Si AI_PROVIDER=gemini, ingresa tu API Key de Google Gemini:
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Si AI_PROVIDER=openai, ingresa tu API Key de OpenAI:
OPENAI_API_KEY=tu_openai_api_key_aqui
